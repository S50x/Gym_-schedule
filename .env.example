# ── انسخ هذا الملف باسم .env وعبّي القيم ──
# Copy this file to .env and fill in the values.

# المنفذ اللي يشتغل عليه السيرفر
PORT=3000

# production أو development — لا تشغّله production بدون HTTPS
NODE_ENV=production

# مكان قاعدة البيانات (ملف SQLite). لازم يكون على قرص دائم مو مؤقت.
DB_PATH=./data/app.sqlite

# سر توقيع الكوكيز — ولّده بأمر: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# لا ترفعه على GitHub أبداً. لو تغيّر، كل الجلسات تنتهي.
SESSION_SECRET=

# عنوان الموقع النهائي — يُستخدم للتحقق من Origin ضد هجمات CSRF.
# مثال: https://hadeed.example.com   (بدون / في الآخر)
ORIGIN=http://localhost:3000

# اتركها 1 لو السيرفر خلف بروكسي/لود بالانسر (Render, Railway, Fly, Nginx) عشان يقرأ IP الحقيقي.
TRUST_PROXY=0

# افتح/اقفل التسجيل الجديد. اقفله (0) بعد ما تسوي حسابك عشان ما أحد يسجّل عندك.
ALLOW_REGISTRATION=1
