# ── انسخ هذا الملف باسم .env وعبّي القيم ──
# Copy this file to .env and fill in the values.

# المنفذ اللي يشتغل عليه السيرفر
PORT=3000

# production أو development — لا تشغّله production بدون HTTPS
NODE_ENV=production

# ── قاعدة البيانات ──
# رابط Postgres. هذا هو الربط الوحيد بين التطبيق وقاعدة البيانات —
# أي مزوّد يشتغل: Render أو Neon أو Supabase أو Postgres على جهازك.
# مثال: postgres://user:pass@host:5432/dbname?sslmode=require
#
# الاتصال مشفّر بـ TLS تلقائياً وشهادة المزوّد تُفحص. Neon و Supabase
# شهاداتهم موثّقة وتشتغل مباشرة. لو مزوّدك يستخدم شهادة موقّعة ذاتياً
# (بعض إعدادات Render)، ضيف sslmode=no-verify في آخر الرابط.
#
# لو تركته فاضي، التطبيق يشغّل Postgres مدمج داخل العملية (PGlite) ويحفظ
# في المجلد تحت. مناسب للتجربة على جهازك، وغير مناسب للنشر على استضافة
# بدون قرص دائم — لأن الملفات تنمسح مع كل إعادة تشغيل.
DATABASE_URL=

# مجلد قاعدة البيانات المدمجة (يُستخدم فقط لما DATABASE_URL فاضي).
DB_PATH=./data/pgdata

# سر توقيع الكوكيز — ولّده بأمر: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# لا ترفعه على GitHub أبداً. لو تغيّر، كل الجلسات تنتهي.
SESSION_SECRET=

# عنوان الموقع النهائي — يُستخدم للتحقق من Origin ضد هجمات CSRF.
# مثال: https://hadeed.example.com   (بدون / في الآخر)
ORIGIN=http://localhost:3000

# اتركها 1 لو السيرفر خلف بروكسي/لود بالانسر (Render, Railway, Fly, Nginx) عشان يقرأ IP الحقيقي.
TRUST_PROXY=0

# افتح/اقفل التسجيل الجديد. اقفله (0) بعد ما تسوي حسابك عشان ما أحد يسجّل عندك.
ALLOW_REGISTRATION=1

# ── البريد (إعادة تعيين كلمة السر) ──
# التطبيق يرسل رابط «نسيت كلمة السر» عن طريق Resend. هذا هو الربط الوحيد
# مع خدمة البريد — سجّل في resend.com، ولّد مفتاح API، وحطّه هنا.
#
# لو تركت RESEND_API_KEY فاضي: التطبيق يشتغل عادي، وصفحة «نسيت كلمة السر»
# ترد نفس الرد (ما تكشف إذا البريد مسجّل أو لا)، بس ما يطلع أي إيميل.
RESEND_API_KEY=

# الإيميل اللي تطلع منه الرسالة. للتجربة استخدم دومين Resend الجاهز
# (onboarding@resend.dev). للإنتاج وثّق دومينك في Resend واستخدم بريد منه،
# مثال: حديد <no-reply@yourdomain.com>
MAIL_FROM=حديد <onboarding@resend.dev>
